# tools/notify/.env — configuração REAL das notificações
#
# NÃO versionado (o .gitignore da raiz cobre `.env`).
# Copie este arquivo para cá (ou renomeie .env.example -> .env) e preencha.
#
# Passo-a-passo no README.md desta pasta.

# Token do bot criado no @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=

# Seu chat_id — veja como obter no README.md.
TELEGRAM_CHAT_ID=

# 1 = envia Telegram; 0 = só GitHub. Sem token/chat_id, o notify.sh ignora.
ENABLE_TELEGRAM=1

# 'auto' = detecta o PR do branch atual via `gh` (recomendado).
# Ou informe um número fixo (ex.: 104) / URL completa do PR/issue.
GITHUB_REF=auto