{
  "openapi": "3.0.3",
  "info": {
    "title": "EduMaps Analytics API",
    "description": "API para execução de análises estatísticas e espaciais.",
    "version": "1.0.0"
  },

  "paths": {
    "/chart": {
      "post": {
        "summary": "Gera um gráfico analítico",
        "description": "Executa uma análise gráfica sobre um dataset tabular e retorna a representação Plotly.",
        "operationId": "createChart",

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChartRequest"
              },
              "example": {
                "chart_type": "scatter",
                "data": [
                  {
                    "x_value": 10,
                    "y_value": 20
                  },
                  {
                    "x_value": 15,
                    "y_value": 27
                  },
                  {
                    "x_value": 21,
                    "y_value": 31
                  },
                  {
                    "x_value": 28,
                    "y_value": 42
                  }
                ],
                "variables": {
                  "x_label": "População",
                  "y_label": "Indicador"
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Gráfico gerado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },

          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },

          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno ao gerar o gráfico"
                }
              }
            }
          }
        }
      }
    },

    "/similarity": {
      "post": {
        "summary": "Calcula a similaridade entre entidades",
        "description": "Calcula a distância e a similaridade de Gower entre todos os pares de entidades do dataset.",
        "operationId": "calculateSimilarity",

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimilarityRequest"
              },

              "examples": {
                "schools": {
                  "summary": "Comparação de escolas",
                  "description": "Exemplo utilizando características numéricas, booleanas e categóricas.",
                  "value": {
                    "data": [
                      {
                        "school_id": "ESC001",
                        "students": 420,
                        "teachers": 28,
                        "urban": true,
                        "network": "municipal"
                      },
                      {
                        "school_id": "ESC002",
                        "students": 450,
                        "teachers": 30,
                        "urban": true,
                        "network": "municipal"
                      },
                      {
                        "school_id": "ESC003",
                        "students": 180,
                        "teachers": 14,
                        "urban": false,
                        "network": "municipal"
                      },
                      {
                        "school_id": "ESC004",
                        "students": 700,
                        "teachers": 45,
                        "urban": true,
                        "network": "estadual"
                      }
                    ],
                    "variables": {
                      "entity_id": "school_id",
                      "features": ["students", "teachers", "urban", "network"]
                    }
                  }
                },

                "defaults": {
                  "summary": "Exemplo utilizando os valores padrão do modelo.",
                  "description": "Quando variables é omitido, a coluna school_id é utilizada como identificador e todas as demais colunas são utilizadas como features.",
                  "value": {
                    "data": [
                      {
                        "school_id": "ESC001",
                        "students": 420,
                        "teachers": 28
                      },
                      {
                        "school_id": "ESC002",
                        "students": 450,
                        "teachers": 30
                      },
                      {
                        "school_id": "ESC003",
                        "students": 180,
                        "teachers": 14
                      }
                    ]
                  }
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Similaridade calculada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarityResponse"
                },
                "example": {
                  "analysis": "gower_similarity",
                  "parameters": {
                    "entity_id": "school_id",
                    "features": ["students", "teachers", "urban", "network"]
                  },
                  "data": [
                    {
                      "entity_id_a": "ESC001",
                      "entity_id_b": "ESC002",
                      "distance": 0.0833,
                      "similarity": 0.9167
                    },
                    {
                      "entity_id_a": "ESC001",
                      "entity_id_b": "ESC003",
                      "distance": 0.5625,
                      "similarity": 0.4375
                    },
                    {
                      "entity_id_a": "ESC002",
                      "entity_id_b": "ESC004",
                      "distance": 0.3812,
                      "similarity": 0.6188
                    }
                  ],
                  "metrics": {
                    "n_entities": 4,
                    "n_features": 4,
                    "n_pairs": 6,
                    "mean_similarity": 0.63
                  },
                  "metadata": {
                    "entity_id": "school_id",
                    "features": ["students", "teachers", "urban", "network"]
                  },
                  "tables": []
                }
              }
            }
          },

          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Features não encontradas: students"
                }
              }
            }
          },

          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno ao calcular similaridade"
                }
              }
            }
          }
        }
      }
    },

    "/cluster": {
      "post": {
        "summary": "Executa clusterização sobre uma tabela",
        "description": "Agrupa as entidades de uma tabela (kmeans, dbscan, gmm ou spectral), escreve os cluster_id de volta na tabela de origem e insere os metadados em analytics.clustering_metadata.",
        "operationId": "runCluster",

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClusterRequest"
              },
              "example": {
                "schema": "staging",
                "table_name": "censo_escolas",
                "id_column": "co_entidade",
                "features": ["qt_mat_bas", "qt_doc_bas"],
                "parameters": {
                  "algorithm": "kmeans",
                  "clusters": 4
                },
                "output_schema": "analytics"
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Clusters computados e persistidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterResponse"
                }
              }
            }
          },

          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },

          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno ao computar o clustering"
                }
              }
            }
          }
        }
      }
    },

    "/summary": {
      "post": {
        "summary": "Gera o resumo estatístico de um município",
        "description": "Executa a EDA de um município (matrículas, docentes, distribuição por dependência), gera os gráficos Plotly e faz upsert em analytics.city_school_analytics.",
        "operationId": "runCitySummary",

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CitySummaryRequest"
              },
              "example": {
                "codigo_ibge": "3550308",
                "schema": "clean",
                "parameters": {
                  "type": "full_summary"
                },
                "output_schema": "analytics"
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Resumo computado e persistido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitySummaryResponse"
                }
              }
            }
          },

          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },

          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno ao gerar o resumo da cidade"
                }
              }
            }
          }
        }
      }
    },

    "/similarity/db": {
      "post": {
        "summary": "Calcula a similaridade entre entidades de uma tabela",
        "description": "Calcula a distância e a similaridade de Gower entre todos os pares de entidades de uma tabela e persiste os pares em analytics.similarity_pairs (append por run).",
        "operationId": "calculateSimilarityFromDb",

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimilarityDbRequest"
              },
              "example": {
                "schema": "staging",
                "table_name": "censo_escolas",
                "id_column": "co_entidade",
                "features": ["qt_mat_bas", "qt_doc_bas", "tp_dependencia"],
                "output_schema": "analytics"
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Similaridade calculada e persistida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarityDbResponse"
                }
              }
            }
          },

          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },

          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno ao calcular similaridade"
                }
              }
            }
          }
        }
      }
    },

    "/ask": {
      "post": {
        "summary": "Pergunta ao Assistente do Censo (NL -> SQL)",
        "description": "Recebe uma pergunta em linguagem natural do gestor sobre a base do Censo Escolar, traduz para SQL, executa (somente leitura, escopo do município do gestor) e responde em markdown com resultado e, opcionalmente, uma especificação Plotly.",
        "operationId": "askCenso",

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              },
              "example": {
                "pergunta": "Quais escolas municipais oferecem ensino em Libras na minha região?",
                "contexto": {
                  "cod_municipio": 3550308,
                  "cod_inep": 35002929,
                  "nome_escola": "EMEF Exemplo",
                  "nome_municipio": "São Paulo",
                  "sg_uf": "SP"
                }
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Resposta gerada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },

          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "A pergunta é obrigatória.",
                  "tipo": "invalid_request"
                }
              }
            }
          },

          "502": {
            "description": "Modelo de linguagem indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Falha ao conversar com o modelo de linguagem",
                  "tipo": "provider"
                }
              }
            }
          },

          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno ao processar a pergunta",
                  "tipo": "internal"
                }
              }
            }
          }
        }
      }
    },

    "/school_profile": {
      "post": {
        "summary": "Gera o Perfil da Escola",
        "description": "Dado um co_entidade (código INEP), devolve um payload pronto para o painel do gestor: diagnóstico, posição relativa (município/rede/Brasil), benchmarking justo (peers via Gower e cluster) e sinais de atenção (quartil inferior dentro do cluster).",
        "operationId": "createSchoolProfile",

        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchoolProfileRequest"
              },
              "example": {
                "co_entidade": 23165669
              }
            }
          }
        },

        "responses": {
          "200": {
            "description": "Perfil gerado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolProfileResponse"
                }
              }
            }
          },

          "400": {
            "description": "Requisição inválida (co_entidade inexistente ou malformado)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Escola não encontrada: 99999999"
                }
              }
            }
          },

          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno ao gerar o perfil da escola"
                }
              }
            }
          }
        }
      }
    },

    "/health": {
      "get": {
        "summary": "Verifica a saúde do serviço",
        "description": "Retorna o estado atual do serviço analítico.",
        "operationId": "health",

        "responses": {
          "200": {
            "description": "Serviço disponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    }
  },

  "components": {
    "schemas": {
      "TabularRow": {
        "type": "object",
        "description": "Uma linha de um dataset tabular.",
        "additionalProperties": true
      },

      "ChartRequest": {
        "type": "object",
        "required": ["chart_type", "data"],
        "properties": {
          "chart_type": {
            "type": "string",
            "description": "Tipo de gráfico a ser gerado.",
            "enum": ["histogram", "scatter", "boxplot"]
          },

          "data": {
            "type": "array",
            "description": "Dataset tabular utilizado pela análise.",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/TabularRow"
            }
          },

          "variables": {
            "type": "object",
            "description": "Parâmetros específicos da análise gráfica.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },

      "SimilarityRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "description": "Dataset contendo uma entidade por linha.",
            "minItems": 2,
            "items": {
              "$ref": "#/components/schemas/TabularRow"
            }
          },

          "variables": {
            "$ref": "#/components/schemas/SimilarityVariables"
          }
        },
        "additionalProperties": false
      },

      "SimilarityVariables": {
        "type": "object",
        "description": "Parâmetros utilizados para construir o modelo de similaridade.",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Nome da coluna que identifica unicamente cada entidade.",
            "default": "school_id"
          },

          "features": {
            "type": "array",
            "description": "Colunas utilizadas como características no cálculo da similaridade de Gower. Quando omitido, todas as colunas, exceto entity_id, são utilizadas.",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },

      "SimilarityPair": {
        "type": "object",
        "required": ["entity_id_a", "entity_id_b", "distance", "similarity"],
        "properties": {
          "entity_id_a": {
            "type": "string",
            "description": "Identificador da primeira entidade."
          },

          "entity_id_b": {
            "type": "string",
            "description": "Identificador da segunda entidade."
          },

          "distance": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 1,
            "description": "Distância de Gower entre as entidades."
          },

          "similarity": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 1,
            "description": "Similaridade entre as entidades, calculada como 1 - distance."
          }
        },
        "additionalProperties": false
      },

      "SimilarityMetrics": {
        "type": "object",
        "required": ["n_entities", "n_features", "n_pairs", "mean_similarity"],
        "properties": {
          "n_entities": {
            "type": "integer",
            "description": "Número de entidades analisadas."
          },

          "n_features": {
            "type": "integer",
            "description": "Número de features utilizadas."
          },

          "n_pairs": {
            "type": "integer",
            "description": "Número de pares de entidades produzidos."
          },

          "mean_similarity": {
            "type": "number",
            "format": "double",
            "description": "Similaridade média entre os pares."
          }
        },
        "additionalProperties": false
      },

      "SimilarityMetadata": {
        "type": "object",
        "description": "Metadados associados ao resultado da análise.",
        "additionalProperties": true
      },

      "SimilarityResponse": {
        "type": "object",
        "required": [
          "analysis",
          "parameters",
          "data",
          "metrics",
          "metadata",
          "tables"
        ],
        "properties": {
          "analysis": {
            "type": "string",
            "description": "Nome da análise executada.",
            "example": "gower_similarity"
          },

          "parameters": {
            "$ref": "#/components/schemas/SimilarityVariables"
          },

          "data": {
            "type": "array",
            "description": "Pares de entidades ordenados pela similaridade decrescente.",
            "items": {
              "$ref": "#/components/schemas/SimilarityPair"
            }
          },

          "metrics": {
            "$ref": "#/components/schemas/SimilarityMetrics"
          },

          "metadata": {
            "$ref": "#/components/schemas/SimilarityMetadata"
          },

          "tables": {
            "type": "array",
            "description": "Tabelas auxiliares produzidas pela análise.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      },

      "ClusterParameters": {
        "type": "object",
        "description": "Parâmetros específicos do algoritmo de clusterização.",
        "properties": {
          "algorithm": {
            "type": "string",
            "enum": ["kmeans", "dbscan", "gmm", "spectral"],
            "default": "kmeans"
          },

          "clusters": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10,
            "description": "Número de clusters (kmeans, gmm e spectral)."
          },

          "eps": {
            "type": "number",
            "minimum": 0,
            "description": "Raio de vizinhança do dbscan."
          },

          "min_pts": {
            "type": "integer",
            "minimum": 1,
            "description": "Pontos mínimos do dbscan."
          }
        },
        "additionalProperties": false
      },

      "ClusterRequest": {
        "type": "object",
        "required": ["table_name", "id_column"],
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema da tabela de origem.",
            "default": "staging"
          },

          "table_name": {
            "type": "string",
            "description": "Tabela contendo as entidades a agrupar."
          },

          "id_column": {
            "type": "string",
            "description": "Coluna que identifica unicamente cada entidade."
          },

          "features": {
            "type": "array",
            "description": "Colunas numéricas usadas como features. Quando omitido, todas as colunas numéricas (exceto id_column) são usadas.",
            "items": {
              "type": "string"
            }
          },

          "filter": {
            "type": "object",
            "description": "Filtro de igualdade por coluna, restringindo o conjunto a clusterizar. Ex.: {\"co_regiao\": 1, \"co_uf\": 35}.",
            "additionalProperties": {
              "type": ["number", "string", "integer"]
            }
          },

          "parameters": {
            "$ref": "#/components/schemas/ClusterParameters"
          },

          "output_schema": {
            "type": "string",
            "description": "Schema onde os metadados são gravados.",
            "default": "analytics"
          }
        },
        "additionalProperties": false
      },

      "ClusterResponse": {
        "type": "object",
        "required": [
          "analysis",
          "parameters",
          "data",
          "metrics",
          "metadata",
          "tables",
          "persisted"
        ],
        "properties": {
          "analysis": {
            "type": "string",
            "description": "Nome da análise executada, no formato cluster_<algoritmo>."
          },

          "parameters": {
            "$ref": "#/components/schemas/ClusterParameters"
          },

          "data": {
            "type": "array",
            "description": "Atribuição de cluster por entidade.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },

          "metrics": {
            "type": "object",
            "description": "Contagens e métricas escalares da execução.",
            "additionalProperties": true
          },

          "metadata": {
            "type": "object",
            "description": "Metadados do dataset (entity_id, features, data_source).",
            "additionalProperties": true
          },

          "tables": {
            "type": "array",
            "description": "Tabelas auxiliares (ex.: estatísticas por cluster).",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },

          "persisted": {
            "type": "object",
            "description": "Informações sobre a persistência do resultado.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },

      "CitySummaryRequest": {
        "type": "object",
        "required": ["codigo_ibge"],
        "properties": {
          "codigo_ibge": {
            "type": "string",
            "description": "Código IBGE do município (7 dígitos)."
          },

          "schema": {
            "type": "string",
            "description": "Schema dos dados do censo.",
            "default": "clean"
          },

          "parameters": {
            "type": "object",
            "description": "Parâmetros da análise.",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["full_summary", "school_clusters", "score_distributions"],
                "default": "full_summary"
              }
            }
          },

          "output_schema": {
            "type": "string",
            "description": "Schema onde o resumo é persistido.",
            "default": "analytics"
          }
        },
        "additionalProperties": false
      },

      "CitySummaryResponse": {
        "type": "object",
        "required": [
          "analysis",
          "parameters",
          "data",
          "metrics",
          "metadata",
          "tables",
          "persisted"
        ],
        "properties": {
          "analysis": {
            "type": "string",
            "description": "Nome da análise executada."
          },

          "parameters": {
            "type": "object",
            "additionalProperties": true
          },

          "data": {
            "type": "array",
            "description": "Dataset de escolas do município que alimentou o resumo.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },

          "metrics": {
            "type": "object",
            "description": "Estatísticas globais do município.",
            "additionalProperties": true
          },

          "metadata": {
            "type": "object",
            "additionalProperties": true
          },

          "tables": {
            "type": "array",
            "description": "Tabelas auxiliares (ex.: matrículas por nível).",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },

          "persisted": {
            "type": "object",
            "description": "Informações sobre a persistência do resultado.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },

      "SimilarityDbRequest": {
        "type": "object",
        "required": ["table_name"],
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema da tabela de origem.",
            "default": "staging"
          },

          "table_name": {
            "type": "string",
            "description": "Tabela contendo uma entidade por linha."
          },

          "id_column": {
            "type": "string",
            "description": "Coluna que identifica unicamente cada entidade.",
            "default": "co_entidade"
          },

          "features": {
            "type": "array",
            "description": "Colunas usadas como características. Quando omitido, todas as colunas exceto id_column são usadas.",
            "items": {
              "type": "string"
            }
          },

          "variables": {
            "$ref": "#/components/schemas/SimilarityVariables"
          },

          "output_schema": {
            "type": "string",
            "description": "Schema onde os pares são persistidos.",
            "default": "analytics"
          }
        },
        "additionalProperties": false
      },

      "SimilarityDbResponse": {
        "type": "object",
        "required": [
          "analysis",
          "parameters",
          "data",
          "metrics",
          "metadata",
          "tables",
          "persisted"
        ],
        "properties": {
          "analysis": {
            "type": "string",
            "description": "Nome da análise executada."
          },

          "parameters": {
            "$ref": "#/components/schemas/SimilarityVariables"
          },

          "data": {
            "type": "array",
            "description": "Pares de entidades ordenados pela similaridade decrescente.",
            "items": {
              "$ref": "#/components/schemas/SimilarityPair"
            }
          },

          "metrics": {
            "$ref": "#/components/schemas/SimilarityMetrics"
          },

          "metadata": {
            "$ref": "#/components/schemas/SimilarityMetadata"
          },

          "tables": {
            "type": "array",
            "description": "Tabelas auxiliares produzidas pela análise.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },

          "persisted": {
            "type": "object",
            "description": "Informações sobre a persistência dos pares.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },

      "AskContexto": {
        "type": "object",
        "description": "Contexto do gestor que faz a pergunta. Orientado a valores; pode virão ou omitidos casos não resolvidos.",
        "properties": {
          "cod_municipio": {
            "type": "integer",
            "description": "Código IBGE do município (7 dígitos)."
          },
          "cod_inep": {
            "type": "integer",
            "description": "Código INEP da escola do gestor."
          },
          "nome_escola": {
            "type": "string"
          },
          "nome_municipio": {
            "type": "string"
          },
          "sg_uf": {
            "type": "string",
            "description": "Sigla da UF."
          }
        },
        "additionalProperties": true
      },

      "AskRequest": {
        "type": "object",
        "required": ["pergunta"],
        "properties": {
          "pergunta": {
            "type": "string",
            "description": "Pergunta em linguagem natural do gestor (até 500 caracteres).",
            "minLength": 1,
            "maxLength": 500
          },

          "contexto": {
            "$ref": "#/components/schemas/AskContexto"
          }
        },
        "additionalProperties": false
      },

      "AskChart": {
        "type": "object",
        "nullable": true,
        "description": "Especificação Plotly de um gráfico sugerido. Presente apenas quando a pergunta pede visualização.",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": ["barra", "linha", "pizza"]
          },
          "x": {
            "type": "string"
          },
          "y": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "dados": {
            "type": "object",
            "description": "JSON {data, layout} aceito diretamente pelo config do Plotly.js.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },

      "AskResponse": {
        "type": "object",
        "required": [
          "resposta",
          "sql",
          "origem",
          "linhas",
          "colunas",
          "resultado",
          "chart"
        ],
        "properties": {
          "resposta": {
            "type": "string",
            "description": "Resposta em markdown, orientada ao contexto do gestor."
          },

          "sql": {
            "type": "string",
            "description": "SQL efetivamente executado."
          },

          "origen": {
            "type": "string",
            "description": "Origem dos dados usada na resposta."
          },

          "linhas": {
            "type": "integer",
            "description": "Número de linhas retornadas."
          },

          "colunas": {
            "type": "array",
            "description": "Nomes das colunas retornadas.",
            "items": {
              "type": "string"
            }
          },

          "resultado": {
            "type": "object",
            "description": "Resultado agregado (métricas) da consulta.",
            "additionalProperties": true
          },

          "chart": {
            "$ref": "#/components/schemas/AskChart"
          }
        },
        "additionalProperties": false
      },

      "SchoolProfileRequest": {
        "type": "object",
        "required": ["co_entidade"],
        "properties": {
          "co_entidade": {
            "type": "integer",
            "description": "Código INEP da escola (8 dígitos).",
            "example": 23165669
          },
          "schema": {
            "type": "string",
            "default": "clean",
            "description": "Schema onde os dados do Censo vivem."
          },
          "output_schema": {
            "type": "string",
            "default": "analytics",
            "description": "Schema de persistência (quando persist=true)."
          },
          "include_inactive": {
            "type": "boolean",
            "default": false,
            "description": "Inclui escolas com tp_situacao_funcionamento != 1."
          },
          "clusters": {
            "type": "integer",
            "default": 4,
            "description": "Nº de clusters do kmeans de fallback (cluster restrito ao município)."
          },
          "similarity_threshold": {
            "type": "number",
            "default": 0.3,
            "description": "Distância Gower máxima para considerar um par similar."
          },
          "persist": {
            "type": "boolean",
            "default": false,
            "description": "Persiste o perfil em analytics.school_profile (UPSERT por co_entidade)."
          },
          "refresh": {
            "type": "boolean",
            "default": false,
            "description": "Ignora o perfil materializado e recalcula (por padrão, o endpoint devolve o materializado quando o ano do censo bate)."
          }
        },
        "additionalProperties": false
      },

      "SchoolProfileResponse": {
        "type": "object",
        "required": ["analysis", "metadata", "tables"],
        "properties": {
          "analysis": {
            "type": "string",
            "example": "school_profile"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "array",
            "items": {},
            "description": "Vazio: o perfil entrega tudo em `tables`."
          },
          "metrics": {
            "type": "object",
            "description": "cluster_size, n_indicadores, n_peers, n_flags, total_escolas_municipio/rede/brasil.",
            "additionalProperties": true
          },
          "metadata": {
            "type": "object",
            "description": "Identificação da escola + bloco do cluster.",
            "properties": {
              "co_entidade": { "type": "string" },
              "no_entidade": { "type": "string" },
              "co_municipio": { "type": "integer" },
              "no_municipio": { "type": "string" },
              "sg_uf": { "type": "string" },
              "nu_ano_censo": { "type": "integer" },
              "cluster_id": { "type": "integer", "nullable": true },
              "cluster_label": { "type": "string", "nullable": true },
              "cluster_source": {
                "type": "string",
                "enum": ["persisted", "fallback_kmeans", "none"]
              },
              "cluster_scope": { "type": "string", "nullable": true },
              "cluster_size": { "type": "integer", "nullable": true },
              "cluster_run_id": {
                "type": "string",
                "nullable": true,
                "description": "run_id do batch que materializou os percentis do cluster."
              },
              "peers_source": {
                "type": "string",
                "enum": ["similarity_pairs", "gower_municipio"]
              },
              "reference_source_municipio": {
                "type": "string",
                "enum": ["reference", "live"],
                "description": "Se a média do município veio da referência pré-computada ou foi calculada ao vivo."
              },
              "reference_source_rede": {
                "type": "string",
                "enum": ["reference", "live"]
              },
              "reference_source_brasil": {
                "type": "string",
                "enum": ["reference", "live"]
              },
              "cached": {
                "type": "boolean",
                "description": "true quando o perfil veio materializado (sem recomputar)."
              },
              "computed_at": {
                "type": "string",
                "nullable": true,
                "description": "Quando o perfil materializado foi gravado."
              }
            },
            "additionalProperties": true
          },
          "tables": {
            "type": "object",
            "properties": {
              "indicadores_comparados": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "indicador": { "type": "string" },
                    "label": { "type": "string" },
                    "escola": { "type": "number", "nullable": true },
                    "municipio": { "type": "number", "nullable": true },
                    "rede": { "type": "number", "nullable": true },
                    "brasil": { "type": "number", "nullable": true },
                    "cluster": { "type": "number", "nullable": true },
                    "quartil_no_cluster": { "type": "integer", "nullable": true },
                    "atencao": { "type": "boolean" }
                  }
                }
              },
              "cluster_resumo": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "indicador": { "type": "string" },
                    "label": { "type": "string" },
                    "media": { "type": "number", "nullable": true },
                    "p25": { "type": "number", "nullable": true },
                    "p50": { "type": "number", "nullable": true },
                    "p75": { "type": "number", "nullable": true },
                    "n": { "type": "integer", "nullable": true }
                  }
                }
              },
              "peers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "co_entidade": { "type": "string" },
                    "no_entidade": { "type": "string" },
                    "similarity": { "type": "number" },
                    "ideb_observado": { "type": "number", "nullable": true }
                  }
                }
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "indicador": { "type": "string" },
                    "codigo": { "type": "string" },
                    "severidade": { "type": "string" },
                    "mensagem": { "type": "string" },
                    "escola": { "type": "number", "nullable": true },
                    "quartil_no_cluster": { "type": "integer", "nullable": true }
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      },

      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Mensagem de erro."
          },

          "tipo": {
            "type": "string",
            "description": "Categoria do erro: invalid_request, provider ou internal."
          }
        },
        "additionalProperties": false
      },

      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
