[Unit]
Description=Edumaps API analytics (R Plumber)
After=network.target

[Service]
User=root
WorkingDirectory=<%= $path %>
Environment=EDUMAPS_R_PORT=8000
ExecStart=/usr/bin/Rscript inst/plumber/run.R
Restart=always
# Pilha de C de 64 MB (#219): o Plumber soma quadros à pilha e o dbplyr do
# eduBR (escolas_similares) estourava o limite padrão de 8 MB do R
# ("C stack usage ... too close to the limit").
LimitSTACK=64M

[Install]
WantedBy=multi-user.target