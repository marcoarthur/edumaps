desc "Configure and Install R edumaps package (edumapsr) + Plumber service";
task deploy_analytics_dev => 'analytic.edumaps' => sub {
  my $path = get('edumaps_dir') . '/analysis/edumapsr';

  # Preserva a chave do LLM já existente quando EDUMAPS_LLM_API_KEY não vem
  # no ambiente (evita apagar a chave do .Renviron num `rex prepare`).
  my $llm_api_key = get('llm_api_key');
  if (!length $llm_api_key && is_file("$path/.Renviron")) {
    my ($linha) = grep { /^EDUMAPS_LLM_API_KEY=/ } split /\n/, cat("$path/.Renviron");
    ($llm_api_key) = $linha =~ /^EDUMAPS_LLM_API_KEY=(.*)$/ if $linha;
    $llm_api_key //= '';
  }

  # install R and all packages we need to run edumaps
  pkg $_, ensure => 'present' for (
    qw/
    r-base
    r-base-dev
    libxml2-dev
    libcurl4-openssl-dev
    libsodium-dev
    libx11-dev
    libpq-dev libssl-dev
    /
  );

  file "$path/.Renviron",
  content => template(
    'files/Renviron',
    {
      db_pass => get('db_password'),
      db_user => get('db_user'),
      db_name => get('db_name'),
      db_host => get('db_host') || 'Database',
      db_schema => get('db_schema') || 'clean',
      db_port => get('db_port') || 5432,
      llm_api_key => $llm_api_key,
      llm_provider => get('llm_provider'),
      llm_model => get('llm_model'),
      llm_url => get('llm_url'),
    }
  )
  ;

  # libpq service file usado por RPostgres::Postgres(service = ...).
  # As análises edumapsr e os jobs legados R::Pipe usam 'edumaps_local'.
  file "/root/.pg_service.conf",
    content => template(
      'files/pg_service.conf',
      {
        db_pass => get('db_password'),
        db_user => get('db_user'),
        db_name => get('db_name'),
      }
    )
  ;

  # install R dependencies required by the package — SÓ quando faltar algum pacote
  # (devtools NÃO entra: é fallback de desenvolvimento do run.R; no servidor o
  #  pacote é instalado via R CMD INSTALL, então devtools nunca é necessário)
  my $env = { R_LIBS => "/usr/local/lib/R/site-library"};
  # ellmer: agente LLM do assistente NL/SQL (chartml opcional, não usado).
  my $deps = q{'plumber','ggplot2','plotly','jsonlite',
      'DBI','RPostgres','cluster','dbscan','mclust','kernlab',
      'ellmer','yaml'};

  run qq{
    set -e
    MISSING=\$(Rscript -e "p <- c($deps); cat(paste(p[!sapply(p, requireNamespace, quietly=TRUE)], collapse=','))")
    if [ -n "\$MISSING" ]; then
      echo "Instalando dependências R faltantes: \$MISSING"
      Rscript -e "install.packages(c($deps), repos='https://cloud.r-project.org', Ncpus=4)"
    else
      echo "Dependências R já instaladas — pulando install.packages"
    fi
  };

  # instala o edumapsr na site-library APENAS quando o código mudar
  # (marcador hashado dos fontes do package; evita recompilar todo deploy)
  my $marker = "/root/.edumapsr_md5";
  run qq{
    HASH=\$(cd $path && find DESCRIPTION NAMESPACE R inst src -type f -print0 2>/dev/null | sort -z | xargs -0 md5sum | md5sum | cut -d' ' -f1)
    LAST=\$(cat $marker 2>/dev/null || true)
    if [ "\$HASH" != "\$LAST" ]; then
      echo "Código do edumapsr mudou — reinstalando o package"
      R CMD INSTALL . || exit 1
      printf '%s\n' "\$HASH" > $marker
    else
      echo "edumapsr inalterado — pulando R CMD INSTALL"
    fi
  }, cwd => $path, env => $env;

  # create the service file
  file "/etc/systemd/system/edumaps-analytic.service",
    content => template(
      './files/edumaps-analytic.service',
      {
        path => $path,
      }
    ),
    on_change => sub {
      run q{systemctl daemon-reload};
      run q{systemctl enable --now edumaps-analytic};
    }
  ;
  service 'edumaps-analytic' => 'restart';
};

desc "Configure and Install (Svelte/Vite) Frontend";
task deploy_frontend_dev => 'backend.edumaps' => sub {
  # NodeSource repo (Node 22 LTS)
  run q{
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
  }, unless => q<node -v | cut -d '.' -f1 | sed 's/v//' | xargs -I {} bash -c 'test {} -ge 20'>;

  run qq{apt-get -y update};
  pkg $_, ensure => 'present' for qw(nodejs nginx);

  my $frontend_path = get('edumaps_dir') . "/frontend/edumaps";
  Rex::Logger::info("Installing frontend dependencies");
  run q{npm install}, cwd => $frontend_path;
  Rex::Logger::info("Building frontend");
  run q{npm run build}, cwd => $frontend_path;

  my $web_root = '/var/www/edumaps-frontend';
  run qq{mkdir -p $web_root}, unless => qq{test -d $web_root};
  run qq{rm -rf $web_root/*};  # limpa versões anteriores
  run qq{cp -r $frontend_path/dist/* $web_root/};
  run qq{chown -R www-data:www-data $web_root};

  my $nginx_cnf = "/etc/nginx/sites-available/edumaps-frontend.conf";
  file $nginx_cnf,
    content => template(
      './files/edumaps-frontend-nginx.conf',
      {
        web_root     => $web_root,
        server_name  => get('frontend_server_name') || '_',
        backend_api  => 'http://localhost:3000',
        analytic_api => 'http://analytic:8000',
      }
    ),
    on_change => sub {
      run qq{ln -sf $nginx_cnf /etc/nginx/sites-enabled/};
      run q{nginx -t};
    }
  ;

  # O site 'default' do Debian é default_server e capturaria requisições de
  # hosts não listados no server_name (retornando 404 nas rotas /api/). É
  # removido sempre, para o EduMaps ser o default_server.
  run q{rm -f /etc/nginx/sites-enabled/default};
  run q{nginx -t};
  service 'nginx' => 'restart';
};

desc "Configure and Install PostgreSQL/PostGIS/Sqitch";
task deploy_db_dev => 'database.edumaps' => sub {
  my $pg_version   = 16;
  my $db_name      = get('db_name') || 'edumaps_dev';
  my $db_user      = get('db_user') || 'edumaps';
  my $db_pass      = get('db_password') || 'change_me';
  my $repo_path    = get('edumaps_dir');

  #
  # 0. configure PostgreSQL official repository
  #

  pkg $_, ensure => 'present' for (qw[ 
    curl
    gnupg
    ca-certificates
    lsb-release
    rsync
    sudo
  ],
  "postgresql-$pg_version-ogr-fdw"
  );

  run q{
    install -d /usr/share/postgresql-common/pgdg
  };

  run q{
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    | gpg --dearmor \
    -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg
  }, unless => 'test -f /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg';

  file '/etc/apt/sources.list.d/pgdg.list',
  content => q{
    deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main
  };

  run q{ apt-get update };

  #
  # 1. install packages
  #

  pkg $_, ensure => 'present' for (
    qw(
      build-essential
      libpq-dev
      sqitch
    ),
    "postgresql-$pg_version",
    "postgresql-client-$pg_version",
    "postgresql-$pg_version-postgis-3",
    "postgresql-$pg_version-postgis-3-scripts",
    "postgresql-$pg_version-pgvector",
  );

  #
  # 2. enable + start PostgreSQL
  #

  service 'postgresql' => 'start';
  service 'postgresql' => 'enable';

  #
  # 3. configure PostgreSQL TCP access
  #

  append_if_no_such_line
  "/etc/postgresql/$pg_version/main/postgresql.conf",
  "listen_addresses = '*'"
  ;

  append_if_no_such_line "/etc/postgresql/$pg_version/main/pg_hba.conf",
  "host all all 0.0.0.0/0 scram-sha-256"
  ;

  #
  # 4. create development user
  #

  run qq{
    sudo -u postgres psql -tc "
    SELECT 1
    FROM pg_roles
    WHERE rolname = '$db_user'
    " | grep -q 1
  },
  unless => qq{
    sudo -u postgres psql -tc "
    SELECT 1
    FROM pg_roles
    WHERE rolname = '$db_user'
    " | grep -q 1
  },
  auto_die => 0,
  ;

  run qq{
    sudo -u postgres psql -c "
    CREATE USER $db_user
    WITH PASSWORD '$db_pass'
    CREATEDB;
    "
  },
  unless => qq{
    sudo -u postgres psql -tc "
    SELECT 1
    FROM pg_roles
    WHERE rolname = '$db_user'
    " | grep -q 1
  },
  auto_die => 0,
  ;

  run qq{
    sudo -u postgres psql -c "
      ALTER ROLE $db_user
      WITH SUPERUSER;
    "
  };

  #
  # 5. create database
  #

  run qq{
    sudo -u postgres createdb -O $db_user $db_name
  },
  unless => qq{
    sudo -u postgres psql -lqt | cut -d '\|' -f 1 | grep -qw $db_name
  };

  #
  # 6 Move datasets to /data
  #
  
  LOCAL {
    run qq{
      rsync -avz -e ssh ~/Data/edumaps_data/ database.edumaps:/data/
    };
  };

  #
  # 7. run sqitch deploy
  #
  
  run qq{
    sqitch deploy db:pg://$db_user:$db_pass\@localhost/$db_name
  }, cwd => "$repo_path/data_pipeline";

  #
  # 7b. assistente NL/SQL: ativa LOGIN da role somente-leitura (criada na
  # migration edumaps_leitor_role). A senha NÃO fica em migration (convenção:
  # credenciais fora do repositório) — é parametrizada aqui como as demais.
  #
  run qq{
    sudo -u postgres psql -d $db_name -c "
    ALTER ROLE edumaps_leitor WITH LOGIN PASSWORD '$db_pass';
    "
  };

  #
  # 8. restart postgresql
  #
  service 'postgresql' => 'restart';
};

batch deploy => qw/prepare deploy_backend_dev deploy_db_dev deploy_frontend_dev deploy_minion_dev/;

desc "Install Ollama and pull the default LLM model (assistente NL/SQL do censo)";
task setup_ollama => 'analytic.edumaps' => sub {
  my $model = $ENV{EDUMAPS_OLLAMA_MODEL} || 'qwen2.5:3b';

  pkg $_, ensure => 'present' for qw<curl zstd>;

  run q{test -x /usr/local/bin/ollama || curl -fsSL https://ollama.com/install.sh | sh},
    auto_die => 0;

  # O dicionário do censo no prompt ultrapassa 4k tokens: sem um contexto
  # maior o modelo perde o começo (regras + contexto do gestor) e parodia
  # um chatbot genérico. 16384 sopesa o uso de RAM do host com o tamanho
  # real do system prompt (~8k tokens).
  run q{systemctl status ollama >/dev/null 2>&1 && mkdir -p /etc/systemd/system/ollama.service.d};
  file "/etc/systemd/system/ollama.service.d/override.conf",
    content => "[Service]\nEnvironment=\"OLLAMA_CONTEXT_LENGTH=16384\"\n";

  run q{systemctl daemon-reload && systemctl restart ollama};
  run qq{ollama pull $model}, auto_die => 0;

  run q{sleep 3 && curl -s http://localhost:11434/api/tags | head -c 400};
};

__END__

=head1 NAME

Rexfile - Development deployment automation for EduMaps infrastructure

=head1 DESCRIPTION

This Rexfile provisions and deploys the EduMaps development stack across
multiple hosts.

Current managed components:

=over 4

=item *

Perl backend application (Mojolicious + Minion)

=item *

Svelte/Vite frontend application (static build served by nginx)

=item *

PostgreSQL + PostGIS + Sqitch database infrastructure

=item *

R analytics API (edumapsr Plumber service)

=item *

Systemd service definitions for backend, minion and analytics processes

=back

The deployment model is development-oriented and intentionally syncs the
local working tree directly to remote hosts using rsync.

This means uncommitted local changes are deployed as-is.

=head1 ARCHITECTURE

The deployment currently assumes three hosts (LXC containers on the same
subnet):

=over 4

=item *

C<backend.edumaps>

Responsible for:

=over 2

=item * Perl backend

=item * frontend static build/runtime (nginx)

=item * Minion worker

=item * systemd services

=back

=item *

C<database.edumaps>

Responsible for:

=over 2

=item * PostgreSQL

=item * PostGIS

=item * Sqitch migrations

=item * spatial datasets

=back

=item *

C<analytic.edumaps>

Responsible for:

=over 2

=item * R runtime (r-base)

=item * edumapsr package (analysis/edumapsr)

=item * Plumber API service on port 8000

=back

=back

=head1 IMPORTANT NOTES

=head2 Source of Truth

The local working tree is considered the primary source of truth.

Code is synchronized directly from the developer machine using rsync,
instead of cloning from Git repositories on remote hosts.

=head2 Dist::Zilla Dependency Metadata

The backend currently depends on dependency metadata generated by
Dist::Zilla during build time.

Because no versioned C<cpanfile> exists yet, deployment temporarily copies
the generated C<cpanfile> from build artifacts.

This is a known technical debt and should eventually be replaced by a
real versioned C<cpanfile> committed to the repository.

=head2 Development Environment

This setup is optimized for development environments.

Current choices intentionally favor convenience over production hardening,
including:

=over 4

=item *

Morbo development server

=item *

PostgreSQL superuser permissions

=item *

wide PostgreSQL network access

=item *

direct rsync deployment

=back

These settings should not be reused unchanged in production environments.

=head1 TASKS

=head2 prepare

Installs base operating system dependencies and synchronizes the local
repository to remote hosts.

=head2 deploy_backend_dev

Configures and deploys the Perl backend application and related systemd
services.

=head2 deploy_frontend_dev

Builds and deploys the Svelte/Vite frontend application (C<frontend/edumaps>)
with nginx static hosting.

=back

=head2 deploy_analytics_dev

Installs the R runtime, the C<analysis/edumapsr> package and its dependencies,
and configures the Plumber API service (C<EDUMAPS_R_PORT=8000>).

=head2 deploy_db_dev

Installs and configures PostgreSQL/PostGIS infrastructure and executes
Sqitch migrations.

=head1 ENVIRONMENT VARIABLES

=over 4

=item * C<EDUMAPS_DB_PASS>

Database password

=item * C<EDUMAPS_DB_USER>

Database username

=item * C<EDUMAPS_DB_NAME>

Database name

=back

=head1 AUTHOR

EduMaps development infrastructure

=cut
